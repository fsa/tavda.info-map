---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar";
import "../styles/sidebar.css";
import "../styles/map.css";
---

<Layout title="Карта города — Тавда">
  <div class="wrapper">
    <Sidebar client:load />
    <div class="main-container">
      <div id="map"></div>
    </div>
  </div>

  <script>
    import { initMap } from "../lib/map";
    const instance = initMap("map");
    (window as any).__map = instance;
    window.dispatchEvent(new CustomEvent("map:ready", { detail: instance }));

    // Глобальный флаг — маркер принудительно показан (из locateUser)
    // Используется, чтобы Sidebar мог синхронизироваться даже если React
    // ещё не гидратировался или перерендерился.
    let _markerForceShowHandlers: Array<() => void> = [];
    (window as any).__onMarkerForceShow = (fn: () => void) => {
      _markerForceShowHandlers.push(fn);
    };
    (window as any).__triggerMarkerForceShow = () => {
      for (const fn of _markerForceShowHandlers) fn();
    };
  </script>
</Layout>
